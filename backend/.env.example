PORT=5000

# Postgres (Neon). Use the pooled URL here and the direct (non "-pooler") URL below for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Secret used to sign login sessions. REQUIRED in production - use a long random string.
JWT_SECRET=change-me-to-a-long-random-string

# Google sign-in (required: sign-in is Google-only). Create an OAuth "Web application" client ID at
# https://console.cloud.google.com/apis/credentials and add your site URL
# (e.g. http://localhost:5173 and https://your-app.vercel.app) under "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=

# Adds email + password sign-in for testing. Leave unset in production.
# PASSWORD_AUTH_ENABLED=true

# Vercel Blob for images. Optional locally: without it, images are saved in backend/uploads.
# BLOB_READ_WRITE_TOKEN=
