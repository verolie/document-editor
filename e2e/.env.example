# Copy to e2e/.env and fill in. The tests sign up users and create documents,
# so point these at a disposable database (the Neon "e2e" branch), never production.
# Neon console -> project -> Branches -> e2e -> Connect.

# Pooled URL (host contains "-pooler")
E2E_DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/document%20editor?sslmode=require"
# Direct URL, used to apply migrations before the run
E2E_DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/document%20editor?sslmode=require"
